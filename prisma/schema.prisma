generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
}

// ─── Admin Auth ──────────────────────────────────────────────────────────────

model AdminUser {
  id            String    @id @default(uuid())
  username      String    @unique
  email         String    @unique
  passwordHash  String    @map("password_hash")
  displayName   String?   @map("display_name")
  role          Role      @default(MANAGER)
  batch         Int?      @map("batch")
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  assignedComplaints Complaint[]              @relation("AssignedComplaints")
  statusHistory      ComplaintStatusHistory[] @relation("AdminStatusChanges")
  registrationNotes  Registration[]           @relation("AdminNotes")
  scoredInterviews   InterviewScore[]         @relation("ScoredInterviews")

  @@map("admin_users")
}

// ─── Events & Registrations ──────────────────────────────────────────────────

enum EventStatus {
  coming_soon
  live
  past

  @@map("event_status")
}

enum RegistrationStatus {
  pending
  completed
  rejected
  shortlisted

  @@map("registration_status")
}

model Event {
  id                 String      @id @default(uuid())
  slug               String      @unique
  title              String
  subtitle           String?
  description        String      @default("")
  imageSrc           String?     @map("image_src")
  imagePlaceholder   String?     @map("image_placeholder")
  accentColor        String      @default("#0D0D0D") @map("accent_color")
  status             EventStatus @default(coming_soon)
  autoLiveAt         DateTime?   @map("auto_live_at")
  autoCloseAt        DateTime?   @map("auto_close_at")
  registrationOpen   Boolean     @default(true) @map("registration_open")
  maxRegistrations   Int?        @map("max_registrations")
  formIntro          String?     @map("form_intro")
  isFeatured         Boolean     @default(false) @map("is_featured")
  sortOrder          Int         @default(100) @map("sort_order")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  registrations      Registration[]

  @@index([slug])
  @@index([status])
  @@index([sortOrder])
  @@map("events")
}

model Registration {
  id                 String             @id @default(uuid())
  eventId            String             @map("event_id")
  event              Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fullName           String             @map("full_name")
  registrationNumber String             @map("registration_number")
  batch              Int
  email              String
  phone              String
  hostel             String?
  aboutNetronix      String?            @map("about_netronix")
  skills             String[]
  otherSkill         String?            @map("other_skill")
  // Event-specific answers that don't fit the shared columns above (e.g. the
  // Volunteer Call form's Faculty / essay questions / skill ratings). Null for
  // events that only use the shared fields.
  formData           Json?              @map("form_data")
  status             RegistrationStatus @default(pending)
  adminNotes         String?            @map("admin_notes")
  adminId            String?            @map("admin_id")
  admin              AdminUser?         @relation("AdminNotes", fields: [adminId], references: [id], onDelete: SetNull)
  emailSentAt        DateTime?          @map("email_sent_at")
  isPreRegistration  Boolean            @default(false) @map("is_pre_registration")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  interviewScore     InterviewScore?

  @@unique([eventId, registrationNumber])
  @@index([eventId])
  @@index([status])
  @@index([createdAt])
  @@map("registrations")
}

// ─── Interview scoring ─────────────────────────────────────────────────────
// A single shared scorecard per candidate, filled in by whichever panelist(s)
// interview them. Any admin can view and update it — there is no per-panelist
// ownership, so the numbers reflect the panel's latest consensus, not one
// person's private notes. `scoredById` just tracks who last touched it.

model InterviewScore {
  id             String       @id @default(uuid())
  registrationId String       @unique @map("registration_id")
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  remarks        String?

  // Each metric is scored 1-10 by the panel. Null means "not yet scored".
  confidence     Int?
  communication  Int?
  personality    Int?
  attitude       Int?
  sponsorship    Int?
  gaming         Int?
  networking     Int?
  liason         Int?
  tech           Int?
  pubCreativity  Int?         @map("pub_creativity")

  scoredById     String?      @map("scored_by_id")
  scoredBy       AdminUser?   @relation("ScoredInterviews", fields: [scoredById], references: [id], onDelete: SetNull)

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("interview_scores")
}

// ─── Complaints ──────────────────────────────────────────────────────────────

enum IssueType {
  NETWORK
  WIFI
  LAN
  OTHER
}

enum ComplaintStatus {
  REPORTED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

model Complaint {
  id            String          @id @default(uuid())
  ticketId      String          @unique @map("ticket_id")
  name          String
  email         String
  location      String
  issueType     IssueType       @map("issue_type")
  description   String
  status        ComplaintStatus @default(REPORTED)
  adminResponse String?         @map("admin_response")
  assignedToId  String?         @map("assigned_to_id")
  assignedTo    AdminUser?      @relation("AssignedComplaints", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  resolvedAt    DateTime?       @map("resolved_at")

  history       ComplaintStatusHistory[]

  @@index([ticketId, email])
  @@index([status])
  @@index([createdAt])
  @@index([assignedToId])
  @@map("complaints")
}

model ComplaintStatusHistory {
  id             String           @id @default(uuid())
  complaintId    String           @map("complaint_id")
  complaint      Complaint        @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  changedById    String?          @map("changed_by_id")
  changedBy      AdminUser?       @relation("AdminStatusChanges", fields: [changedById], references: [id], onDelete: SetNull)
  previousStatus ComplaintStatus? @map("previous_status")
  newStatus      ComplaintStatus  @map("new_status")
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([complaintId])
  @@index([createdAt])
  @@map("complaint_status_history")
}
